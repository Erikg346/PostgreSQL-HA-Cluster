name: {{ current_node.name }}

data-dir: /var/lib/etcd

listen-peer-urls: http://{{ current_node.ip }}:{{ etcd_peer_port }}

listen-client-urls: http://{{ current_node.ip }}:{{ etcd_client_port }},http://127.0.0.1:{{ etcd_client_port }}

initial-advertise-peer-urls: http://{{ current_node.ip }}:{{ etcd_peer_port }}

advertise-client-urls: http://{{ current_node.ip }}:{{ etcd_client_port }}

initial-cluster: "{{ etcd_initial_cluster }}"

initial-cluster-state: new

initial-cluster-token: "{{ etcd_cluster_token }}"

enable-v2: true